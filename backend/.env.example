# Rename this file to .env before running the project

# Server
PORT=5000
NODE_ENV=development

# MongoDB Compass / Local connection string
# If using MongoDB Compass locally, this is usually:
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce

# JWT
JWT_SECRET=this_is_a_super_secret_key_change_it
JWT_EXPIRES_IN=7d

# Only needed in production: your deployed frontend's URL, used for CORS.
# Leave blank for local development (all origins are allowed automatically).
# Example: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=

