# Only needed for production deployment (e.g. Vercel).
# Leave this file absent/unset during local development —
# Vite's dev server proxy (see vite.config.js) handles /api locally.
#
# Set this to your hosted backend's URL + /api, for example:
# VITE_API_URL=https://mern-ecommerce-backend.onrender.com/api
VITE_API_URL=
